{
  "$defs": {
    "ExtractionRecord": {
      "additionalProperties": false,
      "description": "One extracted field value with its verification provenance.",
      "properties": {
        "field": {
          "description": "Procedure-schema field id, e.g. 'geburtsdatum'",
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source span in normalized coordinates; None only for MatchMode.STRUCTURED (mapper fields have payload provenance instead)"
        },
        "match_mode": {
          "$ref": "#/$defs/MatchMode"
        },
        "match_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fuzzy match score; required when match_mode is FUZZY",
          "title": "Match Score"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "extractor_id": {
          "description": "e.g. 'mapper:v0', 'llm:mistral-...'",
          "title": "Extractor Id",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "match_mode",
        "confidence",
        "extractor_id"
      ],
      "title": "ExtractionRecord",
      "type": "object"
    },
    "MatchMode": {
      "enum": [
        "exact",
        "fuzzy",
        "structured"
      ],
      "title": "MatchMode",
      "type": "string"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Half-open character range [start, end) in NORMALIZED text coordinates.\n\nTranslate back to original-document coordinates via the part's OffsetMap.",
      "properties": {
        "part_id": {
          "description": "ContentPart this span belongs to",
          "title": "Part Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "part_id",
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    },
    "VersionStamp": {
      "additionalProperties": false,
      "description": "Versions of everything that produced an artifact; journal-stamped.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy Version"
        },
        "rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Version"
        },
        "decision_table_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Table Version"
        },
        "thresholds_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thresholds Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "feature_set_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Set Version"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "VersionStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "All verified extractions for one envelope.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/VersionStamp"
    },
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "procedure_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Procedure Id"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ExtractionRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "discarded_count": {
      "default": 0,
      "description": "Number of extractor outputs discarded by span verification; feeds the tier decision toward tier 3",
      "minimum": 0,
      "title": "Discarded Count",
      "type": "integer"
    }
  },
  "required": [
    "created_at",
    "versions",
    "envelope_id",
    "case_id"
  ],
  "title": "ExtractionSet",
  "type": "object",
  "$id": "https://opencode.de/eingangslotse/schemas/v0.1.0/ExtractionSet.schema.json"
}
