{
  "$defs": {
    "AnomalyReason": {
      "additionalProperties": false,
      "description": "One feature-level, caseworker-readable reason.",
      "properties": {
        "feature": {
          "description": "Feature id from the identity-blind set",
          "title": "Feature",
          "type": "string"
        },
        "observed": {
          "description": "Observed value/pattern, rendered",
          "title": "Observed",
          "type": "string"
        },
        "expected": {
          "description": "Expected range/pattern, rendered",
          "title": "Expected",
          "type": "string"
        },
        "contribution": {
          "description": "Signed contribution to the anomaly score",
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "observed",
        "expected",
        "contribution"
      ],
      "title": "AnomalyReason",
      "type": "object"
    },
    "ScorerMode": {
      "enum": [
        "log_only",
        "enforcing"
      ],
      "title": "ScorerMode",
      "type": "string"
    },
    "VersionStamp": {
      "additionalProperties": false,
      "description": "Versions of everything that produced an artifact; journal-stamped.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy Version"
        },
        "rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Version"
        },
        "decision_table_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Table Version"
        },
        "thresholds_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thresholds Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "feature_set_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Set Version"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "VersionStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scorer output for one envelope. Referencable ONLY in downgrade\nconditions of the decision table; the config schema has no other field\nfor it (see config.py).",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/VersionStamp"
    },
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "score": {
      "description": "Calibrated anomaly score",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "threshold_ref": {
      "description": "Id of the calibrated threshold in AgencyRiskConfig",
      "title": "Threshold Ref",
      "type": "string"
    },
    "flagged": {
      "description": "score above the referenced threshold",
      "title": "Flagged",
      "type": "boolean"
    },
    "reasons": {
      "description": "MANDATORY when flagged; a flag without readable reasons never ships",
      "items": {
        "$ref": "#/$defs/AnomalyReason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/ScorerMode",
      "default": "log_only"
    }
  },
  "required": [
    "created_at",
    "versions",
    "envelope_id",
    "case_id",
    "score",
    "threshold_ref",
    "flagged"
  ],
  "title": "AnomalyEvidence",
  "type": "object",
  "$id": "https://opencode.de/eingangslotse/schemas/v0.1.0/AnomalyEvidence.schema.json"
}
