{
  "$defs": {
    "OffsetSegment": {
      "additionalProperties": false,
      "description": "Maps one contiguous normalized range onto its original range.\n\nHalf-open ranges. Segments are ordered and non-overlapping in\nnormalized coordinates.",
      "properties": {
        "norm_start": {
          "minimum": 0,
          "title": "Norm Start",
          "type": "integer"
        },
        "norm_end": {
          "minimum": 0,
          "title": "Norm End",
          "type": "integer"
        },
        "orig_start": {
          "minimum": 0,
          "title": "Orig Start",
          "type": "integer"
        },
        "orig_end": {
          "minimum": 0,
          "title": "Orig End",
          "type": "integer"
        }
      },
      "required": [
        "norm_start",
        "norm_end",
        "orig_start",
        "orig_end"
      ],
      "title": "OffsetSegment",
      "type": "object"
    },
    "SourceType": {
      "description": "Origin quality of a text part; selects span-match mode.",
      "enum": [
        "born_digital",
        "ocr"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TextLayerPart": {
      "additionalProperties": false,
      "description": "Normalized text of one content part plus its offset map.",
      "properties": {
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        },
        "offset_map": {
          "description": "Ordered, non-overlapping segments covering the normalized text",
          "items": {
            "$ref": "#/$defs/OffsetSegment"
          },
          "title": "Offset Map",
          "type": "array"
        }
      },
      "required": [
        "part_id",
        "source_type",
        "normalized_text",
        "offset_map"
      ],
      "title": "TextLayerPart",
      "type": "object"
    },
    "VersionStamp": {
      "additionalProperties": false,
      "description": "Versions of everything that produced an artifact; journal-stamped.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy Version"
        },
        "rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Version"
        },
        "decision_table_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Table Version"
        },
        "thresholds_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thresholds Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "feature_set_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Set Version"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "VersionStamp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "All normalized parts of one envelope.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/VersionStamp"
    },
    "envelope_id": {
      "title": "Envelope Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/TextLayerPart"
      },
      "minItems": 1,
      "title": "Parts",
      "type": "array"
    }
  },
  "required": [
    "created_at",
    "versions",
    "envelope_id",
    "case_id",
    "parts"
  ],
  "title": "TextLayer",
  "type": "object",
  "$id": "https://opencode.de/eingangslotse/schemas/v0.1.0/TextLayer.schema.json"
}
